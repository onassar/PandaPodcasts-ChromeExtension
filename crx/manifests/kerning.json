{
    "name": "Kerning Cultures",
    "short_name": "kerning",
    "description": "Keep up with all the Kerning Cultures episodes!",
    "version": "3.0.0",
    "author": "Oliver Nassar",
    "manifest_version": 3,
    "background": {
        "service_worker": "core/js/runtime/serviceWorker.js"
    },
    "action": {
        "default_title": "Kerning Cultures",
        "default_icon": {
            "16": "apps/kerning/images/logos/favicon/v2/favicon-16x16.png",
            "48": "apps/kerning/images/logos/favicon/v2/favicon-48x48.png",
            "128": "apps/kerning/images/logos/favicon/v2/favicon-128x128.png"
        },
        "default_popup": "/apps/kerning/pages/popup.html"
    },
    "permissions": [
        "notifications"
    ],
    "icons": {
        "16": "apps/kerning/images/logos/favicon/v2/favicon-16x16.png",
        "48": "apps/kerning/images/logos/favicon/v2/favicon-48x48.png",
        "128": "apps/kerning/images/logos/favicon/v2/favicon-128x128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "/apps/*",
                "/core/*"
            ],
            "matches": ["<all_urls>"]
        }
    ]
}
