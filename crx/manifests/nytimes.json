{
    "name": "The New York Times Podcasts",
    "short_name": "nytimes",
    "description": "Keep up with all the New York Times podcasts (including The Daily)!",
    "version": "3.0.0",
    "author": "Oliver Nassar",
    "manifest_version": 3,
    "background": {
        "service_worker": "core/js/runtime/serviceWorker.js"
    },
    "action": {
        "default_title": "The New York Times Podcasts",
        "default_icon": {
            "16": "apps/nytimes/images/logos/favicon-white-16x16.png",
            "48": "apps/nytimes/images/logos/favicon-white-48x48.png",
            "128": "apps/nytimes/images/logos/favicon-white-128x128.png"
        },
        "default_popup": "/apps/nytimes/pages/popup.html"
    },
    "permissions": [
        "notifications"
    ],
    "icons": {
        "16": "apps/nytimes/images/logos/favicon-white-16x16.png",
        "48": "apps/nytimes/images/logos/favicon-white-48x48.png",
        "128": "apps/nytimes/images/logos/favicon-white-128x128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "/apps/*",
                "/core/*"
            ],
            "matches": ["<all_urls>"]
        }
    ]
}
