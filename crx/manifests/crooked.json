{
    "name": "Pod Save America & Crooked Media",
    "short_name": "crooked",
    "description": "Keep up with all the Pod Save America & Crooked Media episodes!",
    "version": "3.0.0",
    "author": "Oliver Nassar",
    "manifest_version": 3,
    "background": {
        "service_worker": "core/js/runtime/serviceWorker.js"
    },
    "action": {
        "default_title": "Pod Save America & Crooked Media",
        "default_icon": {
            "16": "apps/crooked/images/logos/favicon-transparent-16x16.png",
            "48": "apps/crooked/images/logos/favicon-transparent-48x48.png",
            "128": "apps/crooked/images/logos/favicon-transparent-128x128.png"
        },
        "default_popup": "/apps/crooked/pages/popup.html"
    },
    "permissions": [
        "notifications"
    ],
    "icons": {
        "16": "apps/crooked/images/logos/favicon-transparent-16x16.png",
        "48": "apps/crooked/images/logos/favicon-transparent-48x48.png",
        "128": "apps/crooked/images/logos/favicon-transparent-128x128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "/apps/*",
                "/core/*"
            ],
            "matches": ["<all_urls>"]
        }
    ]
}
